# Rename this file to .env and fill in your values.
# Never commit your .env to source control.
# Only ONE option needs to be filled in — first match wins.

# ── Option 1: HyperSpace proxy (or any corporate gateway) ────────────────────
LLM_URL=
LLM_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022
# Set to "anthropic" if your proxy routes to Claude; "openai" for GPT models
LLM_PROVIDER=anthropic

# ── Option 2: OpenAI direct ───────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Option 3: SAP AI Core ─────────────────────────────────────────────────────
AI_CORE_URL=
AI_CORE_TOKEN=
AI_CORE_MODEL=gpt-4o

# ── Shared ────────────────────────────────────────────────────────────────────
AI_CORE_MAX_TOKENS=4000
AI_CORE_TIMEOUT=120

# ── Backend service ───────────────────────────────────────────────────────────
PORT=5000
BACKEND_HOST=localhost
BACKEND_PORT=5000
DATASET_TTL_SEC=3600
